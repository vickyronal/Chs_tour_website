---
// Homepage hero: the plane-window sky fades while the "Who's travelling?" cards fade
// in and expand to fill the screen; then the intro and the rest of the page follow.
import Arrow from './Arrow.astro';
import WhoTravelling from './WhoTravelling.astro';
import ScrollExpandMedia from '@/components/ui/scroll-expansion-hero';
import { company } from '../data/company';
import { telLink, whatsappLink } from '../lib/enquiry';
---
<div class="hx">
  <ScrollExpandMedia
    client:load
    mediaType="custom"
    revealOnScroll
    bgImageSrc="/hero/hero-sky.webp"
    titleSplit={['Go anywhere,', 'with someone to call.']}
    date="Philippines · Bali · Maldives · Sri Lanka"
    scrollToExpand="Scroll to arrive"
  >
    <WhoTravelling slot="media" />
    <div class="hx__foot">
      <div class="hero__intro">
        <p>Philippines, Bali, Maldives and Sri Lanka, planned with a real person at our Chennai office. Flights and visa handled.</p>
        <a class="btn btn--light" href={whatsappLink()}>
          Plan on WhatsApp
          <span class="btn__arrow"><Arrow /></span>
        </a>
      </div>
      <aside class="hx__card" aria-label="Our office">
        <p class="hx__card-title accent">Come and meet us</p>
        <p>{company.address.line1}<br />{company.address.line2}</p>
        <a href={telLink()}>{company.phone}</a>
      </aside>
    </div>
  </ScrollExpandMedia>
</div>

<style>
  .hx {
    margin: var(--frame-gap);
    overflow: hidden;
    border-radius: var(--radius-frame);
    background: #0c1530; /* top colour of the sky photo */
    color: var(--text-on-dark);
  }
  .hx :global(.sx-title) {
    display: block;
    font-size: clamp(3.25rem, 9vw, 8.5rem);
    font-stretch: 78%;
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-shadow: 0 2px 24px rgb(13 16 20 / 0.45);
  }
  .hx :global(.sx-title--accent) {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.25rem, 5.5vw, 5rem);
    letter-spacing: -0.01em;
  }
  .hx :global(.sx-date) {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    white-space: nowrap;
    text-shadow: 0 1px 12px rgb(13 16 20 / 0.6);
  }
  .hx :global(.sx-hint) {
    white-space: nowrap;
    margin-top: 4px;
    font-size: 1rem;
    font-weight: 500;
    text-shadow: 0 1px 12px rgb(13 16 20 / 0.6);
  }
  .hx :global(.sx-pause) {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 20;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }
  .hx__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
  }
  .hero__intro { display: grid; justify-items: start; gap: 20px; max-width: 32rem; }
  .hero__intro p { font-size: clamp(1.0625rem, 1.5vw, 1.25rem); line-height: 1.4; }
  .hx__card {
    display: grid;
    gap: 6px;
    width: 19rem;
    padding: 20px 24px;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 28px;
    font-size: 1rem;
    line-height: 1.4;
  }
  .hx__card-title { font-size: 1.625rem; line-height: 1.1; }
  .hx__card a { font-weight: 600; text-underline-offset: 3px; }

  @media (max-width: 760px) {
    .hx__card { width: 100%; }
    /* Headline sits in the open sky below the header, clear of the wingtip */
    .hx :global(h1) { transform: translateY(calc(150px - 50dvh)); }
    .hx :global(.sx-title) { font-size: clamp(2.75rem, 13vw, 3.5rem); }
    .hx :global(.sx-title--accent) { font-size: clamp(1.875rem, 8.6vw, 2.375rem); }
    .hx :global(.sx-date) { font-size: 1.0625rem; }
    /* Intro under the hero: less empty space, full-width tap targets */
    .hx :global(section section) { padding-top: 8px; }
    .hero__intro { max-width: none; }
    .hero__intro .btn { width: 100%; justify-content: space-between; }
  }
  /* Short phones: the hint would sit under the WhatsApp bar */
  @media (max-width: 760px) and (max-height: 700px) {
    .hx :global(.sx-hint) { display: none; }
  }
</style>
