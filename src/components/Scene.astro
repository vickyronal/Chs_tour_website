---
import { photos, type SceneName } from '../lib/scene';

interface Props {
  name: SceneName;
  /** Width the photo shows at, so browsers pick the right file. */
  sizes?: string;
  /** Load straight away: for the main photo on a page. */
  eager?: boolean;
  /** Set when the photo carries meaning of its own. */
  described?: boolean;
}
const { name, sizes = '(max-width: 760px) 70vw, 340px', eager = false, described = false } = Astro.props;
const photo = photos[name];
---
<img
  class="scene"
  src={`/destinations/${name}-640.webp`}
  srcset={`/destinations/${name}-640.webp 640w, /destinations/${name}-1024.webp 1024w`}
  sizes={sizes}
  width="640"
  height="853"
  alt={described ? photo.alt : ''}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  style={`object-position: ${photo.focus}`}
/>
