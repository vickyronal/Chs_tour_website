---
// Homepage "From our travellers": a dark band with a centre-focused row of tall
// arch-topped story cards. The centred card plays a short silent preview; any
// card opens the full-screen viewer with sound. Ratings show only when real.
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import ReviewViewer from './ReviewViewer.astro';
import Scene from './Scene.astro';

interface Props {
  reviews: CollectionEntry<'reviews'>[];
}
const { reviews } = Astro.props;

/** Real review ratings only, e.g. { source: 'Google', score: 4.8, count: 120 }. Empty hides the row. */
const ratings: { source: string; score: number; count: number }[] = [];
---
<section class="stories" aria-labelledby="stories-title">
  <div class="stories__head">
    <h2 class="stories__title" id="stories-title">From our <span class="accent">travellers.</span></h2>
    {ratings.length > 0 && (
      <ul class="stories__ratings">
        {ratings.map((r) => <li><strong>{r.score}/5</strong> {r.source}, {r.count} reviews</li>)}
      </ul>
    )}
  </div>

  <div class="stories__stage" data-stories>
    <button class="round stories__nav stories__nav--prev" type="button" data-story-step="-1" aria-label="Previous story">
      <span class="stories__flip"><Arrow /></span>
    </button>
    <ul class="stories__track" data-story-track>
      {reviews.map((review) => {
        const r = review.data;
        const isVideo = r.type === 'video' && r.src;
        return (
          <li class="story" data-story>
            <a
              class="story__card"
              href={r.src ?? '/reviews'}
              aria-label={`${isVideo ? 'Play video from' : 'Open photo from'} ${r.name}, ${r.trip}`}
              data-open
              data-type={r.type}
              data-src={r.src}
              data-poster={r.poster}
              data-caption={`${r.name}, ${r.trip}`}
              data-quote={r.quote}
            >
              <span class="story__media" data-media>
                {r.poster || (r.type === 'photo' && r.src)
                  ? <img src={r.poster ?? r.src!} alt="" loading="lazy" />
                  : r.scene && <Scene name={r.scene} sizes="(max-width: 760px) 64vw, 330px" />}
                {isVideo && <video class="story__preview" muted playsinline preload="none" data-preview-src={r.src} aria-hidden="true"></video>}
                {!r.verified && <span class="story__badge">Sample</span>}
                {isVideo && (
                  <span class="story__play" aria-hidden="true">
                    <svg width="18" height="20" viewBox="0 0 20 22"><path d="M2 1.8v18.4L18.5 11z" fill="currentColor" /></svg>
                  </span>
                )}
              </span>
            </a>
            <p class="story__name">{r.name}</p>
            <span class="story__tag">{r.trip}</span>
          </li>
        );
      })}
    </ul>
    <button class="round stories__nav stories__nav--next" type="button" data-story-step="1" aria-label="Next story">
      <Arrow />
    </button>
  </div>

  <div class="stories__more">
    <a class="btn btn--light" href="/reviews">
      See all reviews
      <span class="btn__arrow"><Arrow /></span>
    </a>
  </div>
</section>

<ReviewViewer />

<script>
  const stage = document.querySelector<HTMLElement>('[data-stories]');
  if (stage) {
    const track = stage.querySelector<HTMLElement>('[data-story-track]')!;
    const items = [...track.querySelectorAll<HTMLElement>('[data-story]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active: HTMLElement | null = null;
    let inView = false;

    const centre = (item: HTMLElement, behavior: ScrollBehavior = reduce ? 'auto' : 'smooth') => {
      track.scrollTo({ left: item.offsetLeft - (track.clientWidth - item.offsetWidth) / 2, behavior });
    };

    // The centred card plays a silent preview for up to 5 seconds, then rests
    const preview = () => {
      items.forEach((item) => {
        const video = item.querySelector<HTMLVideoElement>('.story__preview');
        if (!video) return;
        if (item === active && inView && !reduce) {
          if (!video.src) video.src = video.dataset.previewSrc!;
          video.currentTime = 0;
          video.play().then(() => item.classList.add('is-playing')).catch(() => {});
        } else {
          video.pause();
          item.classList.remove('is-playing');
        }
      });
    };
    items.forEach((item) => {
      const video = item.querySelector<HTMLVideoElement>('.story__preview');
      video?.addEventListener('timeupdate', () => {
        if (video.currentTime >= 5) {
          video.pause();
          item.classList.remove('is-playing');
        }
      });
      video?.addEventListener('ended', () => item.classList.remove('is-playing'));
    });

    const updateActive = () => {
      const mid = track.getBoundingClientRect().left + track.clientWidth / 2;
      const distance = (el: HTMLElement) => {
        const b = el.getBoundingClientRect();
        return Math.abs(b.left + b.width / 2 - mid);
      };
      const closest = items.reduce((a, b) => (distance(b) < distance(a) ? b : a));
      if (closest === active) return;
      active = closest;
      items.forEach((item) => item.classList.toggle('is-active', item === active));
      preview();
    };

    let frame = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(updateActive);
    }, { passive: true });

    stage.querySelectorAll<HTMLButtonElement>('[data-story-step]').forEach((button) => {
      button.addEventListener('click', () => {
        const i = items.indexOf(active ?? items[0]);
        centre(items[(i + Number(button.dataset.storyStep) + items.length) % items.length]);
      });
    });

    // Keyboard users: a focused card comes to the centre
    track.addEventListener('focusin', (event) => {
      const item = (event.target as HTMLElement).closest<HTMLElement>('[data-story]');
      if (item) centre(item);
    });

    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      preview();
    }, { threshold: 0.5 }).observe(track);

    centre(items[Math.floor((items.length - 1) / 2)], 'auto');
    updateActive();
  }
</script>

<style>
  .stories {
    margin: var(--frame-gap);
    padding-block: clamp(56px, 8vw, 104px) clamp(48px, 6vw, 80px);
    overflow: hidden;
    border-radius: var(--radius-frame);
    background: var(--ink);
    color: var(--text-on-dark);
  }
  .stories__head {
    display: grid;
    justify-items: center;
    gap: 20px;
    padding-inline: var(--gutter);
    text-align: center;
  }
  .stories__title {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-stretch: 85%;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .stories__title .accent { color: var(--sky-slate); font-size: 1.08em; }
  .stories__ratings { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 32px; color: var(--text-on-dark-muted); }
  .stories__ratings strong { color: var(--paper); }

  .stories__stage { position: relative; margin-top: clamp(36px, 5vw, 64px); }
  .stories__track {
    --item: clamp(230px, 23vw, 330px);
    display: flex;
    align-items: flex-start;
    gap: clamp(14px, 2vw, 28px);
    padding-inline: calc(50% - var(--item) / 2);
    padding-block: 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .stories__track::-webkit-scrollbar { display: none; }

  .story { flex: 0 0 var(--item); scroll-snap-align: center; text-align: center; }
  .story__card {
    display: block;
    border-radius: 999px 999px 26px 26px;
    overflow: hidden;
    color: inherit;
    transform: scale(0.94);
    filter: brightness(0.62) saturate(0.85);
    transition: transform 0.6s var(--ease), filter 0.6s var(--ease);
  }
  .story.is-active .story__card { transform: scale(1); filter: none; }
  .story__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 5;
    background: var(--dusk);
  }
  .story__media > :global(img),
  .story__preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .story__preview { opacity: 0; transition: opacity 0.5s ease; }
  .story.is-playing .story__preview { opacity: 1; }
  @media (hover: hover) and (pointer: fine) {
    .story__card:hover .story__media > :global(img) { transform: scale(1.06); }
  }
  .story__card:focus-visible { outline: 3px solid var(--paper); outline-offset: 4px; }
  .story__badge {
    position: absolute;
    top: 16%;
    left: 50%;
    translate: -50% 0;
    padding: 4px 14px;
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .story__play {
    position: absolute;
    left: 50%;
    bottom: 18px;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding-left: 3px;
    border-radius: 50%;
    background: var(--red);
    color: #fff;
  }
  .story__name {
    margin-top: 18px;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    font-weight: 500;
    line-height: 1.25;
  }
  .story__tag {
    display: inline-block;
    margin-top: 10px;
    padding: 4px 16px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.14);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .stories__nav {
    position: absolute;
    top: 36%;
    z-index: 1;
  }
  .stories__nav--prev { left: var(--gutter); }
  .stories__nav--next { right: var(--gutter); }
  .stories__flip { display: block; transform: scaleX(-1); }
  .stories__more { display: flex; justify-content: center; margin-top: clamp(32px, 4vw, 48px); }

  @media (max-width: 760px) {
    .stories__track { --item: 64vw; }
    .stories__nav { display: none; }
  }
</style>
