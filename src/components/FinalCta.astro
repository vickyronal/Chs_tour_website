---
import Arrow from './Arrow.astro';
import { whatsappLink } from '../lib/enquiry';

const { message } = Astro.props as { message?: string };
---
<section class="dark-panel cta">
  <h2 class="section-title">Tell us where <span class="accent">you'd like to go.</span></h2>
  <a class="btn btn--light" href={whatsappLink(message)}>
    Plan on WhatsApp
    <span class="btn__arrow"><Arrow /></span>
  </a>
</section>

<style>
  .cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
</style>
