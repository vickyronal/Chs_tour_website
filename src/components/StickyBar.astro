---
import { telLink, whatsappLink } from '../lib/enquiry';

const { message } = Astro.props as { message?: string };
---
<nav class="bar" aria-label="Quick contact">
  <a class="bar__main" href={whatsappLink(message)}>Plan on WhatsApp</a>
  <a class="bar__call" href={telLink()}>Call</a>
</nav>

<style>
  .bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 10;
    display: none;
    grid-template-columns: 1fr auto;
    gap: 8px;
    padding: 8px 10px calc(8px + env(safe-area-inset-bottom));
    background: var(--stone);
  }
  .bar a {
    display: grid;
    place-items: center;
    min-height: 52px;
    padding-inline: 24px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    text-decoration: none;
  }
  .bar__main { background: var(--ink); color: var(--paper); }
  .bar__call { background: var(--paper); color: var(--ink); }

  @media (max-width: 760px) {
    .bar { display: grid; }
  }
</style>
