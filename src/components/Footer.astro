---
import { getCollection } from 'astro:content';
import { company } from '../data/company';
import { telLink, whatsappLink } from '../lib/enquiry';

const hasReviews = (await getCollection('reviews')).length > 0;
---
<footer class="footer">
  <img src="/brand/logo.png" alt="CHS Tours" width="168" height="85" />
  <div class="footer__col">
    <h2>Talk to us</h2>
    <a href={telLink()}>{company.phone}</a>
    <a href={whatsappLink()}>WhatsApp us</a>
  </div>
  <div class="footer__col">
    <h2>Visit us</h2>
    <address>
      {company.address.line1}<br />{company.address.line2}<br />{company.address.line3}
    </address>
    <a href={company.mapsUrl}>Get directions</a>
  </div>
  <div class="footer__col">
    <h2>Explore</h2>
    <a href="/tours">Tours</a>
    <a href="/destinations">Destinations</a>
    {hasReviews && <a href="/reviews">Reviews</a>}
    <a href="/faq">FAQ</a>
    <a href="/going-abroad">Going abroad</a>
  </div>
  <div class="footer__legal">
    <p>© {new Date().getFullYear()} {company.name}</p>
    <a href="/privacy">Privacy</a>
    <a href="/terms">Terms</a>
    <a href="/cancellation">Cancellation and refund</a>
  </div>
</footer>

<style>
  .footer {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 32px;
    margin: var(--frame-gap);
    padding: clamp(32px, 5vw, 64px);
    border-radius: var(--radius-frame);
    background: var(--ink);
    color: var(--text-on-dark);
  }
  .footer__col { display: grid; align-content: start; justify-items: start; gap: 6px; }
  .footer h2 {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.2;
  }
  .footer address { font-style: normal; color: var(--text-on-dark-muted); }
  .footer a { text-underline-offset: 3px; }
  .footer__legal {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 1rem;
    color: var(--text-on-dark-muted);
  }

  @media (max-width: 760px) {
    .footer { grid-template-columns: 1fr; margin-bottom: 84px; }
  }
</style>
