---
import Arrow from '../components/Arrow.astro';
import PageHero from '../components/PageHero.astro';
import Planner from '../components/Planner.astro';
import { company } from '../data/company';
import { telLink, whatsappLink } from '../lib/enquiry';
import Page from '../layouts/Page.astro';
---
<Page title="Contact | CHS Tours" description="Call, WhatsApp or visit CHS Tours on Mount Road, Chennai.">
  <PageHero title="Talk to us" accent="however suits you." />
  <section class="section section--tight ways">
    <div class="way">
      <h2>WhatsApp</h2>
      <a class="btn" href={whatsappLink()}>Message us <span class="btn__arrow"><Arrow /></span></a>
    </div>
    <div class="way">
      <h2>Call</h2>
      <a href={telLink()}>{company.phone}</a>
    </div>
    <div class="way">
      <h2>Visit</h2>
      <address>{company.address.line1}<br />{company.address.line2}<br />{company.address.line3}</address>
      <a href={company.mapsUrl}>Get directions</a>
    </div>
  </section>
  <Planner />
</Page>

<style>
  .ways { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .way {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 8px;
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--card-bg);
  }
  .way h2 { font-family: var(--font-accent); font-style: italic; font-size: 2rem; font-weight: 400; line-height: 1.1; }
  address { font-style: normal; }
  @media (max-width: 760px) { .ways { grid-template-columns: 1fr; } }
</style>
