---
import { getCollection, type CollectionEntry } from 'astro:content';
import Arrow from '../../components/Arrow.astro';
import FaqList from '../../components/FaqList.astro';
import FinalCta from '../../components/FinalCta.astro';
import Notice from '../../components/Notice.astro';
import Scene from '../../components/Scene.astro';
import TourCard from '../../components/TourCard.astro';
import { faqs } from '../../data/content';
import { destinations } from '../../data/destinations';
import { formatAmount, whatsappLink } from '../../lib/enquiry';
import Page from '../../layouts/Page.astro';

export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map((tour) => ({ params: { slug: tour.id }, props: { tour, tours } }));
}

const { tour, tours } = Astro.props as { tour: CollectionEntry<'tours'>; tours: CollectionEntry<'tours'>[] };
const t = tour.data;
const place = destinations.find((d) => d.slug === t.destination)!;
const message = `Hi CHS Tours, I'd like help planning this trip: ${t.title}.`;
const plannerLink = `/contact?where=${encodeURIComponent(place.name)}&tour=${encodeURIComponent(t.title)}#plan`;
const related = tours.filter((o) => o.id !== tour.id).slice(0, 3);
---
<Page title={`${t.title} | CHS Tours`} description={t.summary} whatsappMessage={message}>
  <section class="top">
    <Scene name={t.scene} sizes="100vw" eager described />
    <div class="top__text">
      <p class="chips">
        <span class="chip">{t.days} days, {t.nights} nights</span>
        {formatAmount(t.fromPrice)
          ? <span class="chip chip--price">From <strong>{formatAmount(t.fromPrice)}</strong> per person</span>
          : <span class="chip">Price on request</span>}
      </p>
      <h1>{t.title}</h1>
      <p class="top__summary">{t.summary}</p>
      <a class="btn btn--light" href={whatsappLink(message)}>Plan on WhatsApp <span class="btn__arrow"><Arrow /></span></a>
    </div>
  </section>

  <div class="section section--tight">
    {!t.verified && <Notice>this is a sample trip. The itinerary, inclusions and price need confirming by CHS.</Notice>}
    <h2 class="section-title">Highlights</h2>
    <ul class="tick-list hl">{t.highlights.map((h) => <li>{h}</li>)}</ul>
  </div>

  <section class="section section--tight" aria-labelledby="days-title">
    <h2 class="section-title" id="days-title">Day <span class="accent">by day.</span></h2>
    <p class="route" aria-label={`Route: ${t.route.join(', ')}`}>
      {t.route.map((stop) => <span>{stop}</span>)}
    </p>
    <nav class="days-nav" aria-label="Jump to a day" data-days-nav>
      {t.itinerary.map((d) => <a href={`#day-${d.day}`}>Day {d.day}</a>)}
    </nav>
    <ol class="days">
      {t.itinerary.map((d) => (
        <li id={`day-${d.day}`} data-day>
          <h3><span class="accent">Day {d.day}.</span> {d.title}</h3>
          <p>{d.description}</p>
          {d.meals && <p class="days__meals">{d.meals}</p>}
        </li>
      ))}
    </ol>
  </section>

  <section class="section section--tight incl">
    <div><h2>What's included</h2><ul class="tick-list">{t.included.map((i) => <li>{i}</li>)}</ul></div>
    <div><h2>Not included</h2><ul class="tick-list tick-list--off">{t.excluded.map((i) => <li>{i}</li>)}</ul></div>
  </section>

  <section class="section section--tight facts">
    <div><h2>Stay</h2><p>{t.stay}</p></div>
    <div><h2>Getting around</h2><p>{t.transport}</p></div>
    <div><h2>Best time to go</h2><p>{t.bestTime}</p></div>
    <div><h2>Visa</h2><p>{t.visa}</p></div>
    <div><h2>Flights</h2><p>{t.flights}</p></div>
    <div><h2>Money</h2><p>{t.money}</p></div>
  </section>

  {t.notes.length > 0 && (
    <section class="section section--tight">
      <h2 class="section-title">Planner's notes</h2>
      <ul class="tick-list">{t.notes.map((n) => <li>{n}</li>)}</ul>
    </section>
  )}

  <section class="section section--tight">
    <h2 class="section-title">Questions</h2>
    <div class="faq-gap"><FaqList items={faqs.slice(2, 5)} /></div>
    <p class="custom">Want it different? <a href={plannerLink}>Change this trip with us</a>.</p>
  </section>

  <section class="section section--tight">
    <h2 class="section-title">You might <span class="accent">also like</span></h2>
    <ul class="related">{related.map((r) => <li><TourCard tour={r} size="short" /></li>)}</ul>
  </section>

  <FinalCta message={message} />
</Page>

<script>
  const nav = document.querySelector<HTMLElement>('[data-days-nav]')!;
  const links = [...nav.querySelectorAll('a')];
  const observer = new IntersectionObserver((entries) => {
    entries.filter((e) => e.isIntersecting).forEach((e) => {
      links.forEach((l) => {
        if (l.hash === `#${e.target.id}`) {
          l.setAttribute('aria-current', 'step');
          nav.scrollLeft = l.offsetLeft - (nav.clientWidth - l.offsetWidth) / 2;
        } else l.removeAttribute('aria-current');
      });
    });
  }, { rootMargin: '-12% 0px -80% 0px' });
  document.querySelectorAll('[data-day]').forEach((d) => observer.observe(d));
</script>

<style>
  .top {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(82svh, 760px);
    margin: var(--frame-gap);
    overflow: hidden;
    border-radius: var(--radius-frame);
    color: var(--text-on-dark);
  }
  .top > :global(img) { position: absolute; inset: 0; }
  /* Keeps the white logo readable over bright skies */
  .top::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    height: 190px;
    background: linear-gradient(to bottom, rgb(13 16 20 / 0.72), rgb(13 16 20 / 0));
    pointer-events: none;
  }
  .top__text {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 14px;
    width: 100%;
    padding: 180px clamp(20px, 3.4vw, 48px) clamp(20px, 3.4vw, 40px);
    background: linear-gradient(to bottom, rgb(13 16 20 / 0), rgb(13 16 20 / 0.86) 45%);
  }
  h1 {
    max-width: 16em;
    font-size: clamp(2.75rem, 7vw, 6rem);
    font-stretch: 80%;
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .chip--price { padding: 6px 16px; font-size: 1rem; }
  .chip--price strong { font-size: 1.25rem; font-weight: 700; font-stretch: 85%; letter-spacing: -0.02em; }
  .top__summary { max-width: 34rem; font-size: 1.125rem; }

  .hl { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); margin-top: 20px; }

  .route { display: flex; flex-wrap: wrap; gap: 6px 0; margin-top: 18px; color: var(--text-muted); }
  .route span:not(:last-child)::after {
    content: '';
    display: inline-block;
    width: 26px;
    height: 1.5px;
    margin-inline: 8px;
    vertical-align: middle;
    background: var(--red);
  }
  .days-nav {
    position: sticky;
    top: 8px;
    z-index: 2;
    display: flex;
    gap: 4px;
    width: fit-content;
    max-width: 100%;
    margin-top: 16px;
    padding: 5px;
    overflow-x: auto;
    border-radius: var(--radius-pill);
    background: var(--paper);
    box-shadow: 0 2px 10px rgb(20 23 28 / 0.1);
    scrollbar-width: none;
  }
  .days-nav a {
    flex: none;
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    font-weight: 500;
    text-decoration: none;
  }
  .days-nav [aria-current='step'] { background: var(--ink); color: var(--paper); }
  .days { display: grid; gap: 10px; margin: 18px 0 0; padding: 0; list-style: none; }
  .days li {
    padding: clamp(18px, 3vw, 28px);
    border-radius: var(--radius-card);
    background: var(--card-bg);
    scroll-margin-top: 76px;
  }
  .days h3 { font-size: 1.375rem; font-weight: 600; line-height: 1.2; letter-spacing: -0.015em; }
  .days h3 .accent { font-size: 1.15em; color: var(--dusk); }
  .days p { margin-top: 6px; max-width: 46rem; }
  .days .days__meals { color: var(--text-muted); font-size: 1rem; }

  .incl { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .incl h2, .facts h2 { margin-bottom: 12px; font-family: var(--font-accent); font-style: italic; font-size: 2rem; font-weight: 400; line-height: 1.1; }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .faq-gap { margin-top: 20px; }
  .custom { margin-top: 16px; }
  .related { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 24px; }

  @media (max-width: 760px) {
    .incl, .facts, .related { grid-template-columns: 1fr; }
  }
</style>
